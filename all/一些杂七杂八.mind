{"root":{"data":{"id":"dlem1408ogg0","created":1789345468087,"text":"嵌入式学习"},"children":[{"data":{"id":"dlem224uxfc0","created":1789345542377,"text":"典型问题排查"},"children":[{"data":{"id":"dlem2b75ywo0","created":1789345562108,"text":"设备死机"},"children":[{"data":{"id":"dlem2fw37zc0","created":1789345572322,"text":"1、是否有触发看门狗"},"children":[{"data":{"id":"dlem2ty4vhc0","created":1789345602921,"text":"有触发看门狗复位：找哪里导致的没有及时喂狗"},"children":[]},{"data":{"id":"dlem3bso2280","created":1789345641772,"text":"没有触发看门狗：找有无死循环、或者阻塞"},"children":[]},{"data":{"id":"dlemvf6jtwo0","created":1789347843339,"text":"看门狗复位时，有没有记录复位原因：上电复位、外部复位、"},"children":[]}]},{"data":{"id":"dlemv3co8680","created":1789347817587,"text":"分支主题"},"children":[]}]}]}]},"template":"default","theme":"fresh-blue","version":"1.4.43"}