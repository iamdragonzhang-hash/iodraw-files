          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="SCV8n_TIHaFa0UEipEWq-61" value="FIFO补充速度&lt;div&gt;本质也由BCLK决定&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-170" y="1090" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="SCV8n_TIHaFa0UEipEWq-63" value="假设本端RX做M，上游的TX做S，那么&lt;br&gt;1、若上游ALGO写ring_buffer速度&amp;gt;dma向FIFO搬运速度，那么在本端看来就是漏了一帧数据&lt;div&gt;2、若上游ALGO写ring_buffer&amp;lt;dma搬运速度，那么在本端看来就是重复一帧旧数据&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-297.5" y="1140" width="510" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pYcYjqN06a3kEVqU8JDs-1" value="&lt;div style=&quot;color: rgb(205, 214, 244); font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; line-height: 27px; white-space-collapse: preserve;&quot;&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-30" y="930" width="20" height="40" as="geometry" />
        </mxCell>
