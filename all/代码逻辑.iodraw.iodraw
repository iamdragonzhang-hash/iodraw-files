        <mxCell id="pYcYjqN06a3kEVqU8JDs-12" value="phy_audio_i2stx.c配置" style="text;whiteSpace=wrap;fontSize=8;" parent="1" vertex="1">
          <mxGeometry x="923.75" y="960" width="82.5" height="20" as="geometry" />
        </mxCell>
        <mxCell id="pYcYjqN06a3kEVqU8JDs-14" value="&lt;div style=&quot;font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; line-height: 24px; white-space-collapse: preserve;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;phy_audio_i2srx.c配置&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-215" y="950" width="110" height="40" as="geometry" />
        </mxCell>
        <mxCell id="pYcYjqN06a3kEVqU8JDs-17" value="// 1) DMA 位宽&#xa;if (DMA_WIDTH_16BITS == width)&#xa;    reg |= I2ST01234_FIFOCTL_TXFIFO_DMAWIDTH;   // 16bit 传输" style="text;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="40" y="1590" width="370" height="40" as="geometry" />
        </mxCell>
        <mxCell id="pYcYjqN06a3kEVqU8JDs-18" value="// 2) FIFO 输入来源 (sel) —— 决定谁往 FIFO 灌数据&#xa;if (FIFO_SEL_CPU == sel)&#xa;    reg |= FIFO_IEN | FIFO_IN_SEL(0);           // CPU 中断模式&#xa;else if (FIFO_SEL_DMA == sel)&#xa;    reg |= FIFO_DEN | FIFO_IN_SEL(1);           // 通用 DMA DRQ&#xa;else if (FIFO_SEL_DSP == sel)&#xa;    reg |= FIFO_IN_SEL(3);                      // DSP 直连&#xa;else if (FIFO_SEL_DSP_DMA == sel)&#xa;    reg |= FIFO_DSPDMA_DEN | FIFO_IN_SEL(4);    // DSP-DMA" style="text;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="40" y="1690" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="pYcYjqN06a3kEVqU8JDs-19" value="// 3) FIFO 复位&#xa;reg |= I2ST01234_FIFOCTL_FIFO_RST;" style="text;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="40" y="1850" width="250" height="50" as="geometry" />
        </mxCell>
        <mxCell id="pYcYjqN06a3kEVqU8JDs-20" value="// 4) DRQ 水位线&#xa;reg |= I2STX01234_FIFOCTL_FIFO_RQ_LEVEL(0xf);   // 32 levels (32*4 bytes)" style="text;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="40" y="1910" width="460" height="50" as="geometry" />
        </mxCell>
        <mxCell id="pYcYjqN06a3kEVqU8JDs-21" value="i2stx_reg-&gt;fifoctl |= reg;       // 写 FIFOCTL 寄存器使能" style="text;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="40" y="1960" width="320" height="40" as="geometry" />
        </mxCell>
