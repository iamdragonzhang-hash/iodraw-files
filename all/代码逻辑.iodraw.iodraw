        <mxCell id="XD_H_2u_Ki3vlOUMKKlV-125" value="这个process做了两件事&lt;br&gt;1、srd改变检测&lt;div&gt;2、clk改变检测&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;dashed=1;dashPattern=8 8;" vertex="1" parent="1">
