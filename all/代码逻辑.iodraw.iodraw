          </mxGeometry>
        </mxCell>
        <mxCell id="XD_H_2u_Ki3vlOUMKKlV-128" value="重新初始化" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="XD_H_2u_Ki3vlOUMKKlV-127">
