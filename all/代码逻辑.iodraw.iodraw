        <mxCell id="SCV8n_TIHaFa0UEipEWq-59" value="FIFO消耗速度，&lt;div&gt;决定DMA搬运速率&lt;/div&gt;&lt;div&gt;本质是由BCLK决定&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="900" y="1080" width="130" height="60" as="geometry" />
