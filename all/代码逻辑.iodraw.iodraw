            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="XD_H_2u_Ki3vlOUMKKlV-129" value="&lt;div style=&quot;color: rgb(205, 214, 244); background-color: rgb(30, 30, 46); font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 14px; line-height: 19px; white-space: pre;&quot;&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;span style=&quot;color: #4fc1ff;&quot;&gt;CLOCK_LOST&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;color: #9cdcfe;&quot;&gt;any_clk_changed&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;" vertex="1" parent="1">
